{
  "extends": ["./src/core/config/.oxlintrc.json"],
  "ignorePatterns": ["src/assets", "**/*.hbs"],
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@shared/**",
              "@modules/**",
              "@/shared/**",
              "@/modules/**"
            ]
          }
        ]
      }
    }
  ]
}
