---
import GlobalLayout from '@/layouts/GlobalLayout.astro';
import AstroJsonLd from '@core/components/astro/AstroJsonLd.astro';
import { SectionRenderer } from '@/modules/cms/SectionRenderer';
import { SiteHeader } from '@/modules/cms/chrome/SiteHeader';
import { SiteFooter } from '@/modules/cms/chrome/SiteFooter';
import type { HeaderPresetDTO } from '@/shared/services/headerPreset/headerPreset.service';
import type { FooterPresetDTO } from '@/shared/services/footerPreset/footerPreset.service';
import type { ContentEntryDTO, FieldDefinitionDTO, RelationDisplayItem, TaxonomyDisplayItem, ResolvedSection, SeoData, PageStyle, PageTranslationDTO } from '@/modules/cms/cms.types';

interface Props {
    seo: SeoData | undefined;
    sections: ResolvedSection[];
    pageEntry?: ContentEntryDTO;
    contentTypeFields?: FieldDefinitionDTO[];
    header?: HeaderPresetDTO;
    footer?: FooterPresetDTO;
    pageStyle?: PageStyle;
    relationDisplay?: Record<string, RelationDisplayItem[]>;
    taxonomyDisplay?: Record<string, TaxonomyDisplayItem[]>;
    /** Bộ chuyển ngôn ngữ (Phase 3 mục 3, Task 15) — xem resolveCmsPageProps.ts. */
    availableTranslations?: PageTranslationDTO[];
}

// `header`/`footer` đã được resolveCmsPageProps() lấy sẵn từ pageResolver — trang
// tự chọn preset (Page.headerPresetId/footerPresetId) thắng, hoặc rơi về preset có
// isDefault=true (xem PageResolver.resolveHeaderFooter phía BE). Cả 2 component
// chrome đều tự dùng giá trị mặc định hardcode khi undefined (chưa cấu hình gì).
const { seo, sections, pageEntry, contentTypeFields, header, footer, pageStyle, relationDisplay, taxonomyDisplay, availableTranslations } = Astro.props;

// Chưa có SEO title tường minh (đa số trang, vì đâu phải admin nào cũng điền SEO cho
// từng bản ghi) -> tự suy ra từ field tiêu đề thật của entry (cùng logic ContentDetailSection
// dùng để chọn field nào là tiêu đề: field TEXT đầu tiên — `isSlugSource` đã bị xoá ở
// mục γ, Task 5). Quan trọng: seoConfig KHÔNG được có key "title" khi không có giá trị
// nào cả — GlobalLayout ghép `{...defaultSEO, ...seoConfig}`, key có mặt dù giá trị
// undefined vẫn đè mất title mặc định của site (bug thật đã phát hiện khi verify JSON-LD).
const fallbackTitle = (() => {
    if (!pageEntry || !contentTypeFields?.length) return undefined;
    const titleField = contentTypeFields.find((f) => f.type === 'TEXT');
    const value = titleField?.key ? pageEntry.data?.[titleField.key] : undefined;
    return typeof value === 'string' && value ? value : undefined;
})();

const seoConfig = {
    ...((seo?.title || fallbackTitle) ? { title: seo?.title || fallbackTitle } : {}),
    ...(seo?.description ? { description: seo.description } : {}),
    ...(seo?.ogImage ? { image: seo.ogImage } : {}),
    ...(seo?.ogTitle ? { ogTitle: seo.ogTitle } : {}),
    ...(seo?.ogDescription ? { ogDescription: seo.ogDescription } : {}),
    ...(seo?.twitterImage ? { twitterImage: seo.twitterImage } : {}),
    ...(seo?.canonicalUrl ? { canonical: seo.canonicalUrl } : {}),
    noindex: seo?.robotsIndex === false,
    nofollow: seo?.robotsFollow === false,
};

// Page.style (Cài đặt trang trong Page Builder) — nền/font riêng cho toàn trang. Font
// áp thẳng lên <body> qua GlobalLayout; nền (màu/gradient/ảnh/video) cần 1 lớp <div>
// riêng (không chỉ 1 CSS property) để hỗ trợ làm mờ ảnh + lớp phủ mà KHÔNG làm mờ luôn
// nội dung phía trên — xem khối render bgType bên dưới. Chỉ set khi admin thực sự chọn,
// không đè lên nền của từng Section (Section vẫn tự vẽ nền riêng của nó).
const bodyStyle: Record<string, string> = {};
if (pageStyle?.fontFamily) bodyStyle.fontFamily = pageStyle.fontFamily;

const bgType = pageStyle?.backgroundType || 'transparent';
const overlayStyle = pageStyle?.overlayColor
    ? { backgroundColor: pageStyle.overlayColor, opacity: String(pageStyle.overlayOpacity ?? 0.4) }
    : undefined;

// JSON-LD (mục 12 spec CMS: "chuẩn SEO") — WebSite trên MỌI trang; Article chỉ khi
// `pageEntry` có giá trị (nghĩa là trang Chi tiết đang xem 1 bản ghi thật, không phải
// trang Danh sách/tĩnh). `header?.logoText` đứng vai "tên site" vì đó là field admin
// đã điền cho đúng mục đích này (logo/tên thương hiệu hiện trên header).
const siteOrigin = (Astro.site?.toString() || 'https://example.com').replace(/\/$/, '');
const siteName = header?.logoText || 'Website';
const currentUrl = `${siteOrigin}${Astro.url.pathname}`;

const websiteSchema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: siteOrigin,
};

const articleHeadline = seo?.title || fallbackTitle;
const articleSchema = pageEntry && articleHeadline ? {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleHeadline,
    description: seo?.description || undefined,
    image: seo?.ogImage ? [seo.ogImage] : undefined,
    datePublished: pageEntry.publishedAt || pageEntry.createdAt || undefined,
    dateModified: pageEntry.updatedAt || pageEntry.publishedAt || pageEntry.createdAt || undefined,
    mainEntityOfPage: currentUrl,
    author: { '@type': 'Organization', name: siteName },
    publisher: { '@type': 'Organization', name: siteName },
} : undefined;

// `seo.structuredData` (Task 6) — object JSON-LD tuỳ chỉnh admin tự nhập cho trang, thêm
// vào CUỐI mảng schema cùng websiteSchema/articleSchema thay vì thay thế chúng. Scalar
// `Mixed` phía generated types khai báo string | undefined (giá trị thật lúc runtime là
// object JSON) -> cast qua `unknown` cho khớp prop `schema` của AstroJsonLd.
const schemas = [websiteSchema, articleSchema, seo?.structuredData as unknown as Record<string, unknown> | undefined].filter(
    (s): s is Record<string, unknown> => Boolean(s),
);
---
<GlobalLayout seo={seoConfig} bodyStyle={Object.keys(bodyStyle).length ? bodyStyle : undefined}>
  <AstroJsonLd schema={schemas} />

  {bgType === 'color' && (
    <div class="fixed inset-0 -z-10" style={{ backgroundColor: pageStyle?.backgroundColor || '#ffffff' }} />
  )}
  {bgType === 'gradient' && (
    <div
      class="fixed inset-0 -z-10"
      style={{ backgroundImage: `linear-gradient(${pageStyle?.gradientAngle ?? 135}deg, ${pageStyle?.gradientFrom || '#4f46e5'}, ${pageStyle?.gradientTo || '#0ea5e9'})` }}
    />
  )}
  {bgType === 'image' && pageStyle?.backgroundImage && (
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={{
          backgroundImage: `url(${pageStyle.backgroundImage})`,
          filter: pageStyle.backgroundImageBlur ? `blur(${pageStyle.backgroundImageBlur}px)` : undefined,
          transform: pageStyle.backgroundImageBlur ? 'scale(1.1)' : undefined,
        }}
      />
      {overlayStyle && <div class="absolute inset-0" style={overlayStyle} />}
    </div>
  )}
  {bgType === 'video' && pageStyle?.backgroundVideo && (
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <video autoplay muted loop playsinline class="h-full w-full object-cover">
        <source src={pageStyle.backgroundVideo} />
      </video>
      {overlayStyle && <div class="absolute inset-0" style={overlayStyle} />}
    </div>
  )}
  <SiteHeader client:load currentPath={Astro.url.pathname} logoText={header?.logoText} navLinks={header?.navLinks} headerMenuId={header?.headerMenuId} animation={header?.animation} availableTranslations={availableTranslations} />
  <main>
    <SectionRenderer client:visible sections={sections} pageEntry={pageEntry} contentTypeFields={contentTypeFields} relationDisplay={relationDisplay} taxonomyDisplay={taxonomyDisplay} />
  </main>
  <SiteFooter
    client:visible
    logoText={footer?.logoText}
    hotlineLabel={footer?.hotlineLabel}
    hotline={footer?.hotline}
    footerHeading={footer?.footerHeading}
    footerEmail={footer?.footerEmail}
    footerColumns={footer?.footerColumns}
    footerMenuId={footer?.footerMenuId}
    footerOutlineText={footer?.footerOutlineText}
    animation={footer?.animation}
  />
</GlobalLayout>
