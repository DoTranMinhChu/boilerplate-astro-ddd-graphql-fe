---
/**
 * Generic JSON-LD structured-data emitter.
 *
 * Usage:
 *   <AstroJsonLd schema={{ '@context': 'https://schema.org', '@type': 'Organization', ... }} />
 *
 * Pass any schema.org-shaped object (Organization, WebSite, BreadcrumbList, ...).
 * The component only serializes it into a <script type="application/ld+json"> tag.
 */
export interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
