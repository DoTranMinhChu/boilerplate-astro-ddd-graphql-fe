---
// Trang chủ CMS — cùng cơ chế Dynamic Page Resolver với [...path].astro (path "/").
// Astro ưu tiên route tĩnh này hơn [...path].astro nên "/" cần xử lý riêng ở đây.
import { resolveCmsPageProps, resolveRedirect } from '@/modules/cms/api/resolveCmsPageProps';
import { resolveCacheControlHeader } from '@/modules/cms/api/resolveCacheControlHeader';
import CmsPageShell from '@/modules/cms/CmsPageShell.astro';
import GlobalLayout from '@/layouts/GlobalLayout.astro';
import { APP_NAME } from 'astro:env/server';

const cmsProps = await resolveCmsPageProps('/');
const siteName = APP_NAME || 'ddd-graphql-fe';

let redirect: { toPath: string; statusCode: number } | null = null;
if (!cmsProps) {
    redirect = await resolveRedirect('/');
    if (redirect) return Astro.redirect(redirect.toPath, redirect.statusCode as 301 | 302);
} else {
    // Item 3.14: chỉ set trên success path thật (đã resolve được page) — không set khi rơi
    // vào redirect ở trên, và cũng không set ở fallback "chưa publish trang chủ" bên dưới.
    Astro.response.headers.set('Cache-Control', resolveCacheControlHeader());
}
---
{cmsProps
    ? <CmsPageShell seo={cmsProps.seo} pageEntry={cmsProps.pageEntry} contentTypeFields={cmsProps.contentTypeFields} header={cmsProps.header} footer={cmsProps.footer} theme={cmsProps.theme} pageStyle={cmsProps.pageStyle} availableTranslations={cmsProps.availableTranslations} nodeTree={cmsProps.nodeTree} locale={cmsProps.locale} pathParams={cmsProps.pathParams} prefetchedRepeatEntries={cmsProps.prefetchedRepeatEntries} />
    : (
        <GlobalLayout seo={{ title: 'Home', description: `${siteName} — chưa có trang chủ nào được publish.` }}>
            <main class="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center">
                <h1 class="text-2xl font-bold text-neutral-900">Chưa có trang chủ được publish</h1>
                <p class="mt-2 text-neutral-500">Vào <code class="rounded bg-neutral-100 px-1.5 py-0.5">/admin/cms/pages</code> để tạo và publish trang với path "/".</p>
                <a href="/admin" class="mt-6 rounded-full bg-neutral-900 px-6 py-3 font-semibold text-white">Vào trang quản trị</a>
            </main>
        </GlobalLayout>
    )}
