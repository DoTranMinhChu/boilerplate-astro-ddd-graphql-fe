---
import GlobalLayout from '@/layouts/GlobalLayout.astro';
import { App } from '@/shared/common/app/App';
import { t } from '@/shared/i18n/t';

// BE (mail.service.ts) hardcode 1 path DUY NHẤT cho link reset password của mọi loại
// account (`RESET_PASSWORD_PATH = '/reset-password'`), phân biệt qua query param `type`
// (admin | merchant | customer). Trang này (SPA `<App client:only>`) chỉ có route cho
// admin/merchant (xem src/modules/auth/resetPassword.page.tsx — KHÔNG có branch
// 'customer'). Customer công khai có trang riêng nhẹ hơn (Phase 4, mục 3, Task 13) —
// redirect sang đó ngay ở SSR, giữ nguyên `token`, trước khi tải cả bundle SPA nặng.
if (Astro.url.searchParams.get('type') === 'customer') {
    return Astro.redirect(`/dat-lai-mat-khau?token=${encodeURIComponent(Astro.url.searchParams.get('token') || '')}`, 302);
}
---

<GlobalLayout
  seo={{
    title: t('pages.resetPassword.title'),
    noindex: true,
    nofollow: true,
  }}
>
  <!-- ✅ CRITICAL: client:only để tránh SSR hydration issues -->
  <App client:only="solid-js" />
</GlobalLayout>
