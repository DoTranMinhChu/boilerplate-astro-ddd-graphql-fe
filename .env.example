# --- App identity ---
APP_NAME="ddd-graphql-fe"
PUBLIC_APP_CODE="ddd-graphql-fe"
ENVIRONMENT="local"
PORT=4321

# --- Backend (paired ddd-graphql-be GraphQL API) ---
BACKEND_URL=http://localhost:3000

# --- Optional host overrides for multi-tenant routing ---
HOSTNAME_DEFAULT=
HOSTNAME_ADMIN=

# --- SEO assets (public/seo/<value>/...) ---
SEO_PUBLIC_PATH=/seo/example

# --- Public site origin, used for canonical URLs / sitemap / OG tags ---
SITE_URL=https://example.com

# --- Deployment target: node | vercel | static ---
DEPLOY_TARGET=node

# --- Google Identity Services (Customer login/register "Đăng nhập bằng Google") ---
# Client ID thật của Google Cloud OAuth consent screen (chủ dự án tự tạo). Rỗng =>
# nút "Đăng nhập bằng Google" tự ẩn hoàn toàn, form mật khẩu vẫn hoạt động bình thường.
PUBLIC_GOOGLE_CLIENT_ID=
